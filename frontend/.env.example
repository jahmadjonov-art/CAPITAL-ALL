# Optional. Only needed if you prefer keeping credentials out of src/config.js
# while developing locally. Copy this file to .env.local and fill it in.
#
# Use the "anon public" key from Supabase → Project Settings → API.
# Never put the service_role key in a file that ships to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
