{
  "name": "capital-allocation-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "install-all": "npm install --workspace=backend && npm install --workspace=frontend",
    "dev": "concurrently \"npm:start --workspace=backend\" \"npm:start --workspace=frontend\"",
    "start": "node backend/index.js"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}
